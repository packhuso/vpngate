[Unit]
Description=VPN Hub Gateway Worker (BullMQ → real gateway agent)
After=network-online.target docker.service vpnhub-api.service
Wants=network-online.target

[Service]
Type=simple
User=packhuso
Group=packhuso
WorkingDirectory=/opt/vpnhub-app/apps/worker-gateway
Environment=NODE_ENV=production
EnvironmentFile=/opt/vpnhub-app/.env
ExecStart=/usr/bin/node /opt/vpnhub-app/apps/worker-gateway/dist/main.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
