[Unit]
Description=VPN Hub API (NestJS)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=packhuso
Group=packhuso
WorkingDirectory=/opt/vpnhub-app/apps/api
Environment=NODE_ENV=production
Environment=API_PORT=3001
EnvironmentFile=/opt/vpnhub-app/.env
ExecStart=/usr/bin/node /opt/vpnhub-app/apps/api/dist/main.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
