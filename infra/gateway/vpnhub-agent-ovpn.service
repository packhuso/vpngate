[Unit]
Description=VPN Hub Gateway Agent (OpenVPN node)
Documentation=https://github.com/vpnhub (docs/vpnhub-agent.yaml)
After=network-online.target openvpn@server.service
Wants=network-online.target
Requires=openvpn@server.service

[Service]
Type=simple
# Root: netlink route (CAP_NET_ADMIN), tc shaping, write CCD files, talk to the
# OpenVPN management socket.
User=root
EnvironmentFile=/etc/vpnhub-agent/agent.env
ExecStart=/usr/local/bin/vpnhub-agent
Restart=on-failure
RestartSec=3
WatchdogSec=0

# Hardening — relaxed vs the WG unit because the OpenVPN backend writes CCD
# files under /etc/openvpn/ccd (ProtectSystem=full would make /etc read-only).
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/etc/openvpn /run

[Install]
WantedBy=multi-user.target
