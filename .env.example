# VPN Hub — environment template. Copy to .env and fill in real secrets.
# Never commit the real .env (design Section 6.5).

# PostgreSQL
POSTGRES_DB=vpnhub
POSTGRES_USER=vpnhub
POSTGRES_PASSWORD=change-me-strong-random

# Redis
REDIS_PASSWORD=change-me-strong-random

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-strong-random

# Caddy — set to real domain when DNS ready; empty = internal :80 only
CADDY_DOMAIN=
CADDY_EMAIL=

DATABASE_URL=postgresql://vpnhub:change-me-strong-random@127.0.0.1:5432/vpnhub
REDIS_URL=redis://default:change-me-strong-random@127.0.0.1:6379

APP_SECRET_KEY=change-me-64-hex-chars

WORKER_TLS_CLIENT_CERT=/opt/vpnhub-app/infra/pki/worker.crt
WORKER_TLS_CLIENT_KEY=/opt/vpnhub-app/infra/pki/worker.key

GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REDIRECT_URI=https://portal.myip.in.th/api/auth/callback/google
PORTAL_BASE_URL=https://portal.myip.in.th
AUTH_SESSION_TTL_SECONDS=604800
ADMIN_EMAILS=admin@example.com
